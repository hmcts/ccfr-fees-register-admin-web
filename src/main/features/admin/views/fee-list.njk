{% from "includes/macros/fee-amount.njk" import feeAmount %}
  {% extends "layout.njk" %}

  {% set title = t('Fees | ' + serviceName) %}
  {% set heading = t('Fees') %}

  {% block content %}

<div class="govuk-grid-column-full">
  <h3 class="govuk-heading-m">Fees</h3>
  <table class="govuk-table">
    <thead class="govuk-table__head">
    <tr class="govuk-table__row">
      <th class="govuk-table__header" scope="col">{{ t('Code') }}</th>
      <th class="govuk-table__header" scope="col">{{ t('Description') }}</th>
      <th class="govuk-table__header" scope="col">{{ t('Amount') }}</th>
    </tr>
    </thead>
    <tbody class="govuk-table__body">
    {% for fee in fees | sort(attribute='code') %}
    <tr class="govuk-table__row">
      {% if (isFeatureEnabled('edit')) %}
      <td class="govuk-table__cell"><a class="govuk-link" href="/admin/fees/edit/{{ fee.code }}">{{ fee.code }}</a></td>
      {% else %}
      <td class="govuk-table__cell">{{ fee.code }}</td>
      {% endif %}
      <td class="govuk-table__cell">{{ fee.description }}</td>
      <td class="govuk-table__cell">{{ feeAmount(fee) }}</td>
    </tr>
    {% endfor %}
    </tbody>
  </table>

  {% if (isFeatureEnabled('edit')) %}
  <p class="govuk-body"><a href="/admin/fees/create" class="govuk-button" role="button">{{ t("Create new fee") }}</a></p>
  {% endif %}

  <p class="govuk-body"><a href="/admin/welcome/" class="govuk-back-link">{{ t("Back to welcome page") }}</a></p>
</div>

  {% endblock %}
