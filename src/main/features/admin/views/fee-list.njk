{% from "includes/macros/fee-amount.njk" import feeAmount %}
  {% extends "layout.njk" %}

  {% set title = t('Fees | ' + serviceName) %}
  {% set heading = t('Fees') %}

  {% block content %}

<div class="govuk-grid-column-full">
  <h3 class="govuk-heading-m">Fees</h3>
  <table>
    <thead>
    <tr>
      <th scope="col">{{ t('Code') }}</th>
      <th scope="col">{{ t('Description') }}</th>
      <th scope="col">{{ t('Amount') }}</th>
    </tr>
    </thead>
    <tbody>
    {% for fee in fees | sort(attribute='code') %}
    <tr>
      {% if (isFeatureEnabled('edit')) %}
      <td><a href="/admin/fees/edit/{{ fee.code }}">{{ fee.code }}</a></td>
      {% else %}
      <td>{{ fee.code }}</td>
      {% endif %}
      <td>{{ fee.description }}</td>
      <td>{{ feeAmount(fee) }}</td>
    </tr>
    {% endfor %}
    </tbody>
  </table>

  {% if (isFeatureEnabled('edit')) %}
  <p><a href="/admin/fees/create" class="govuk-button" role="button">{{ t("Create new fee") }}</a></p>
  {% endif %}

  <p><a href="/admin/welcome/" class="govuk-back-link">{{ t("Back to welcome page") }}</a></p>
</div>

  {% endblock %}
