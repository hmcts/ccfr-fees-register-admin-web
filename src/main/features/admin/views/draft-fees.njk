{% extends "layout.njk" %}

  {% set title = t('Range Group | ' + serviceName) %}
  {% set heading = 'Range groups' %}

  {% block content %}

<div class="govuk-grid-column-full">
  <table class="govuk-table">
    <thead class="govuk-table__head">
    <tr class="govuk-table__row">
      <th class="govuk-table__header">Category</th>
      <th class="govuk-table__header">Fee code</th>
      <th class="govuk-table__header">Fee description</th>
      <th class="govuk-table__header">Range from</th>
      <th class="govuk-table__header">Range to</th>
      <th class="govuk-table__header">Fixed fee</th>
      <th class="govuk-table__header">Percentage fee</th>
    </tr>
    </thead>
    <tbody class="govuk-table__body">
    {% for category in categories %}
    {% for range in category.rangeGroup.ranges %}
    <tr class="govuk-table__row">
      <td class="govuk-table__cell">{{ category.code }}</td>
      <td class="govuk-table__cell">{{ range.fee.code }}</td>
      <td class="govuk-table__cell">{{ range.fee.description }}</td>
      <td class="govuk-table__cell">{{ range.from }}</td>
      <td class="govuk-table__cell">{{ range.to }}</td>
      <td class="govuk-table__cell">{{ range.fee.amount }}</td>
      <td class="govuk-table__cell">{{ range.fee.percentage }}</td>
    </tr>
    {% endfor %}
    {% for fee in category.fees %}
    <tr class="govuk-table__row">
      <td class="govuk-table__cell">{{ category.code }}</td>
      <td class="govuk-table__cell">{{ fee.code }}</td>
      <td class="govuk-table__cell">{{ fee.description }}</td>
      <td class="govuk-table__cell">{{ fee.from }}</td>
      <td class="govuk-table__cell">{{ fee.to }}</td>
      <td class="govuk-table__cell">{{ fee.amount }}</td>
      <td class="govuk-table__cell">{{ fee.percentage }}</td>
    </tr>
    {% endfor %}
    {% endfor %}
    </tbody>
  </table>
  <p class="govuk-body"><a href="/admin/welcome/" class="govuk-back-link">{{ t("Back to welcome page") }}</a></p>
</div>

  {% endblock %}
