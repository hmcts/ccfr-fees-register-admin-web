{% from "includes/macros/form.njk" import csrfProtection, errorSummary, textArea, textInput, radioGroup, submitButton %}
  {% extends "layout.njk" %}

  {% set title = t('Create Range Group | ' + serviceName) %}
  {% set heading = t('Create Range Group') %}

  {% block content %}

<div class="govuk-grid-row">
  <div class="govuk-grid-column-full">
    <form method="post" action="create">
      {{ csrfProtection(csrfToken) }}
      {{ textInput(t('Code'), 'code', form) }}
      {{ submitButton(t('Next')) }}
    </form>

    <a href="/admin/range-groups" class="govuk-back-link">{{ t('Cancel') }}</a>
  </div>
</div>

  {% endblock %}
