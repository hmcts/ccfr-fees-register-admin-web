{% from "includes/macros/form.njk" import csrfProtection, errorSummary, textArea, textInputInline, selectInline, submitButton %}
  {% extends "layout.njk" %}

  {% set title = t('Category | ' + serviceName) %}
  {% set heading = t('Category ') + form.model.code %}

  {% block content %}

<div class="govuk-grid-row">
  <div class="govuk-grid-column-full">
    <form method="post" action="/admin/categories/edit/{{ form.model.code }}">
      {{ csrfProtection(csrfToken) }}
      <input type="hidden" name="code" value="{{ form.model.code }}"/>
      {{ textArea(t('Description'), 'description', form) }}

      <h3 class="govuk-heading-m">Range Group</h3>
      <table class="govuk-table">
        <thead class="govuk-table__head">
        <tr class="govuk-table__row">
          <th class="govuk-table__header" scope="col">{{ t('Select Range Group') }}</th>
        </tr>
        </thead>
        <tbody class="govuk-table__body">
        <tr class="govuk-table__row ranges-row">
          <td class="govuk-table__cell fee-code">{{ selectInline('rangeGroupCode',rangeOptions, form) }}</td>
        </tr>
        </tbody>
      </table>

      <h3 class="govuk-heading-m">Flat Fees</h3>
      <table class="govuk-table">
        <thead class="govuk-table__head">
        <tr class="govuk-table__row">
          <th class="govuk-table__header" scope="col">{{ t('Add fees') }}</th>
        </tr>
        </thead>
        <tbody class="govuk-table__body">
        {% for fee in form.model.feeCodes %}
        <tr class="govuk-table__row ranges-row">
          <td class="govuk-table__cell fee-code">{{ selectInline('feeCodes['+loop.index0+']',feeOptions, form) }}</td>
        </tr>
        {% endfor %}
        </tbody>
      </table>

      <p class="govuk-body">
        <input type="submit" class="link-button" name="action[addRow]" value="{{ t('+ Add fee') }}">
        <input type="submit" class="link-button" name="action[deleteRow]" value="{{ t('- Delete last fee') }}">
      </p>

      <p class="govuk-body">
        {{ submitButton(t('Save')) }}
      </p>
    </form>

    <p class="govuk-body"><a href="/admin/categories/" class="govuk-back-link">{{ t("Back to categories list") }}</a></p>
  </div>
</div>


  {% endblock %}

