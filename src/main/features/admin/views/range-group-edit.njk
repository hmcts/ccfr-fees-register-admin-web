{% from "includes/macros/form.njk" import csrfProtection, errorSummary, textArea, textInputInline, selectInline, submitButton %}
  {% extends "layout.njk" %}

  {% set title = t('Range Group | ' + serviceName) %}
  {% set heading = t('Range Group ') + form.model.code %}

  {% block content %}

<div class="govuk-grid-row">
  <div class="govuk-grid-column-full">
    <form method="post" action="/admin/range-groups/edit/{{ form.model.code }}">
      {{ csrfProtection(csrfToken) }}
      <input type="hidden" name="code" value="{{ form.model.code }}"/>
      {{ textArea(t('Description'), 'description', form) }}

      <h3 class="govuk-heading-m">Ranges</h3>
      <table class="govuk-table">
        <thead class="govuk-table__head">
        <tr class="govuk-table__row">
          <th class="govuk-table__header" scope="col">{{ t('From') }}</th>
          <th class="govuk-table__header" scope="col">{{ t('To') }}</th>
          <th class="govuk-table__header" scope="col">{{ t('Fee') }}</th>
        </tr>
        </thead>
        <tbody class="govuk-table__body">
        {% for range in form.model.ranges %}
        <tr class="govuk-table__row ranges-row">
          <td class="govuk-table__cell from">{{ textInputInline('ranges['+loop.index0+'][from]', form) }}</td>
          <td class="govuk-table__cell to">{{ textInputInline('ranges['+loop.index0+'][to]', form) }}</td>
          <td class="govuk-table__cell fee-code">{{ selectInline('ranges['+loop.index0+'][feeCode]', feeOptions, form) }}</td>
        </tr>
        {% endfor %}
        </tbody>
      </table>

      <p class="govuk-body">
        <input type="submit" class="link-button" name="action[addRow]" value="{{ t('+ Add another range') }}">
        <input type="submit" class="link-button" name="action[deleteRow]" value="{{ t('- Delete last range') }}">
      </p>

      <p class="govuk-body">
        {{ submitButton(t('Save')) }}
      </p>
    </form>

    <p class="govuk-body"><a href="/admin/range-groups/" class="govuk-back-link">{{ t("Back to range group list") }}</a></p>
  </div>
</div>


  {% endblock %}
