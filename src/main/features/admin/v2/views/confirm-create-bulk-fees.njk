{% extends "layout.njk" %}

  {% set title = t('Create csv fee confirmation | '  + serviceName) %}
  {% set heading = t('Create csv fees confirmation') %}

  {% block content %}

<div class="govuk-grid-row">
  <div class="govuk-grid-column-full">

    {% if bulkFeeError %}
    <div class="govuk-error-summary" data-module="govuk-error-summary">
      <div role="alert">
        <h2 class="govuk-error-summary__title" id="failure-error-summary-heading">
          {{ t('There is a problem') }}
        </h2>
        <div class="govuk-error-summary__body">
          <p class="govuk-body">{{ errCause }}</p>
        </div>
      </div>
    </div>
    {% elif success %}
    <div class="govuk-notification-banner govuk-notification-banner--success" role="alert"
         aria-labelledby="success-banner-title" data-module="govuk-notification-banner">
      <div class="govuk-notification-banner__header">
        <h2 class="govuk-notification-banner__title" id="success-banner-title">{{ t('Success') }}</h2>
      </div>
      <div class="govuk-notification-banner__content">
        <p class="govuk-notification-banner__heading">{{ msg }}</p>
      </div>
    </div>
    {% endif %}

    <a href="/admin/V2/all-fees" class="govuk-link">{{ t('Return to fees') }}</a>
  </div>
</div>
  {% endblock %}
