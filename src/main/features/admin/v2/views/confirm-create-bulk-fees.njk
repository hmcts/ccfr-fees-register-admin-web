{% extends "layout.njk" %}

  {% set title = t('Create csv fee confirmation | '  + serviceName) %}
  {% set heading = t('Create csv fees confirmation') %}

  {% block content %}

<div class="govuk-grid-row">
  <div class="govuk-grid-column-full">

    {% if bulkFeeError %}
    <div class="govuk-error-summary" role="group" aria-labelledby="failure-error-summary-heading" tabindex="-1">
      <h2 class="govuk-error-summary__title" id="failure-error-summary-heading">
        {{ errCause }}
      </h2>
    </div>
    {% elif success %}
    <div class="success-summary" role="group" aria-labelledby="failure-error-summary-heading" tabindex="1">
      <h2 class="govuk-error-summary__title">
        {{ msg }}
      </h2>
    </div>
    {% endif %}
  </div>

  <div class="govuk-grid-column-full">
    <a href="/admin/V2/all-fees" class="govuk-back-link">{{ t('Return to welcome page') }}</a>
  </div>

</div>

  {% endblock %}
