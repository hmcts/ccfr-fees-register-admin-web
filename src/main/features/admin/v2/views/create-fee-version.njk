{% set currentPage = 'create-fee-version' %}

{% from "includes/macros/form.njk" import csrfProtection, textArea, textInput, dateInput, selectReferenceData %}
  {% extends "layout.njk" %}

  {% set title = t('Create Fee Version | ' + serviceName) %}
  {% set heading = t('Create Fee Version') %}

  {% block content %}
<input type='hidden' id='userRole' value='{{ 'Approver' if isApprover(user.allInfo.roles) else 'Editor' }}'/>
{% set amountType = form.valueFor('amountType') %}
{% set amountTypeLabels = { flat: 'Flat', percentage: 'Percentage', volume: 'Volume' } %}
<form method="post" action="" id="create-fee-version-form" novalidate>
  {{ csrfProtection(csrfToken) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-one-half">{{ textInput(t('Memo Line*'), 'memoLine', form) }}</div>
    <div class="govuk-grid-column-one-half">{{ textInput(t('Natural Account Code*'), 'naturalAccountCode', form) }}</div>
  </div>

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      {{ textArea(t('Reason For Fee Update'), 'reasonForUpdate', form, rows=2) }}
      {{ textArea(t('Description*'), 'description', form) }}
    </div>
  </div>

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-one-half">{{ dateInput(t('From Date*'), 'fromDate', form) }}</div>
    <div class="govuk-grid-column-one-half">{{ dateInput(t('To Date'), 'toDate', form) }}</div>
  </div>

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-one-half">
      <div class="govuk-form-group">
        <p class="govuk-body govuk-!-font-weight-bold govuk-!-margin-bottom-1" id="amountType[label]">{{ t('Amount Type') }}</p>
        <p class="govuk-body" id="amountType-value">{{ t(amountTypeLabels[amountType] or amountType) }}</p>
        <input type="hidden" name="amountType" value="{{ amountType }}"/>
      </div>
    </div>
    <div class="govuk-grid-column-one-half">
      {% if amountType == 'percentage' %}
        {{ textInput(t('Percentage (%)*'), 'percentage', form, inputClass='govuk-input--width-10') }}
      {% else %}
        {{ textInput(t('Amount (£)*'), 'amount', form, inputClass='govuk-input--width-10') }}
      {% endif %}
    </div>
  </div>

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-one-half">
      {{ selectReferenceData('direction', referenceData.directionTypes, form, t('Direction*')) }}
    </div>
  </div>

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-one-half">{{ textInput(t('Statutory Instrument'), 'statutoryInstrument', form) }}</div>
    <div class="govuk-grid-column-one-half">{{ textInput(t('SI REF ID'), 'siRefId', form) }}</div>
  </div>

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-one-half">{{ textInput(t('Last Amending SI*'), 'lastAmendingSi', form) }}</div>
    <div class="govuk-grid-column-one-half">{{ textInput(t('Consolidated/Original Fee Order Name*'), 'consolidatedFeeOrderName', form) }}</div>
  </div>

  <div class="govuk-button-group">
    <button id="submit" type="submit" class="govuk-button" data-module="govuk-button">{{ t('Next') }}</button>
    <a href="/admin/v2/all-fees" class="govuk-link">{{ t('Cancel') }}</a>
  </div>
</form>
  {% endblock %}
