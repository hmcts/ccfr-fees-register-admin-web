{% extends "layout1.njk" %}

  {% set title = t('Fees | ' + serviceName) %}
  {% set heading = t('Fees')  %}
  {% set xLargeTable = t('custom') %}
  {% block content %}
    <input type='hidden' id='userRole' value=''/>

<div class="custom-grid-row">
  <p class="govuk-body"><a href="/admin/v2/all-fees" class="govuk-back-link">{{ t("Back to welcome page") }}</a></p>
  <table class="govuk-table">
    <thead class="govuk-table__head">
    <tr class="govuk-table__row">
      <th class="govuk-table__header bold-xxsmall">Code</th>
      <th class="govuk-table__header bold-xxsmall">Description</th>
      <th class="govuk-table__header bold-xxsmall">Amount</th>
      <th class="govuk-table__header bold-xxsmall">Statutory Instrument</th>
      <th class="govuk-table__header bold-xxsmall">Last Amending SI</th>
      <th class="govuk-table__header bold-xxsmall">SI Ref ID</th>
      <th class="govuk-table__header bold-xxsmall">Consolidated/Original Fee Order Name</th>
      <th class="govuk-table__header bold-xxsmall">Service</th>
      <th class="govuk-table__header bold-xxsmall">Jurisdiction1</th>
      <th class="govuk-table__header bold-xxsmall">Jurisdiction2</th>
      <th class="govuk-table__header bold-xxsmall">Event</th>
      <th class="govuk-table__header bold-xxsmall">Range from</th>
      <th class="govuk-table__header bold-xxsmall">Range to</th>
      <th class="govuk-table__header bold-xxsmall">Unit</th>
      <th class="govuk-table__header bold-xxsmall">Fee type</th>
      <th class="govuk-table__header bold-xxsmall">Amount Type</th>
      <th class="govuk-table__header bold-xxsmall">%</th>
      <th class="govuk-table__header bold-xxsmall">Channel</th>
      <th class="govuk-table__header bold-xxsmall">Keyword</th>
      <th class="govuk-table__header bold-xxsmall">Applicant Type</th>
      <th class="govuk-table__header bold-xxsmall">Version</th>
      <th class="govuk-table__header bold-xxsmall">Direction</th>
      <th class="govuk-table__header bold-xxsmall">Valid From</th>
      <th class="govuk-table__header bold-xxsmall">Valid To</th>
      <th class="govuk-table__header bold-xxsmall">Status</th>
      <th class="govuk-table__header bold-xxsmall">Memo</th>
      <th class="govuk-table__header bold-xxsmall">Natural Account Code</th>
    </tr>
    </thead>
    <tbody class="govuk-table__body">
    {% for fee in fees %}
    {% set version = getLastFeeVersion(fee) %}
    {% if version.status === 'approved' %}
    <tr class="govuk-table__row">
      <td class="govuk-table__cell font-xxsmall">
      {% if user %}
        <a class="govuk-link" href="/fees/{{fee.code}}">{{ fee.code }}</a>
      {% else  %}
        <a class="govuk-link" href="/fees/{{fee.code}}">{{ fee.code }}</a>
      {% endif %}
      </td>
      <td class="govuk-table__cell font-xxsmall">{{ version.description }}</td>
      {% if version.flat_amount %}
      <td class="govuk-table__cell font-xxsmall">£{{ version.flat_amount.amount }}</td>
      {% elif version.volume_amount %}
      <td class="govuk-table__cell font-xxsmall">£{{ version.volume_amount.amount }}</td>
      {% else %}
      <td/>
      {% endif %}
      <td class="govuk-table__cell font-xxsmall">{{ version.statutory_instrument }}</td>
      <td class="govuk-table__cell font-xxsmall">{{ version.last_amending_si }}</td>
      <td class="govuk-table__cell font-xxsmall">{{ version.si_ref_id }}</td>
      <td class="govuk-table__cell font-xxsmall">{{ version.consolidated_fee_order_name }}</td>
      <td class="govuk-table__cell font-xxsmall">{{ fee.service_type.name }}</td>
      <td class="govuk-table__cell font-xxsmall">{{ fee.jurisdiction1.name }}</td>
      <td class="govuk-table__cell font-xxsmall">{{ fee.jurisdiction2.name }}</td>
      <td class="govuk-table__cell font-xxsmall">{{ fee.event_type.name }}</td>
      {% if fee.min_range %}
      <td class="govuk-table__cell font-xxsmall">{{ fee.min_range }}</td>
      {% else %}
      <td/>
      {% endif %}
      {% if fee.max_range %}
      <td class="govuk-table__cell font-xxsmall">{{ fee.max_range }}</td>
      {% else %}
      <td/>
      {% endif %}
            <td class="govuk-table__cell font-xxsmall">{{ fee.range_unit }}</td>
      <td class="govuk-table__cell font-xxsmall">{{ fee.fee_type }}</td>
      {% if version.flat_amount %}
      <td class="govuk-table__cell font-xxsmall">Flat</td>
      <td/>
      {% elif version.volume_amount %}
      <td class="govuk-table__cell font-xxsmall">Volume</td>
      <td/>
      {% else %}
      <td class="govuk-table__cell font-xxsmall">Percentage</td>
      <td class="govuk-table__cell font-xxsmall">{{ version.percentage_amount.percentage }}%</td>
      {% endif %}
      <td class="govuk-table__cell font-xxsmall">{{ fee.channel_type.name }}</td>
      <td class="govuk-table__cell font-xxsmall">{{ fee.keyword }}</td>
      <td class="govuk-table__cell font-xxsmall">{{ fee.applicant_type.name }}</td>
      <td class="govuk-table__cell font-xxsmall">{{ version.version }}</td>
      <td class="govuk-table__cell font-xxsmall">{{ version.direction }}</td>
      {% if version.valid_from %}
      <td class="govuk-table__cell font-xxsmall">{{ version.valid_from | date }}</td>
      {% else %}
      <td/>
      {% endif %}
      {% if version.valid_to %}
      <td class="govuk-table__cell font-xxsmall">{{ version.valid_to | date }}</td>
      {% else %}
      <td/>
      {% endif %}
      <td class="govuk-table__cell font-xxsmall">{{ version.status }}</td>
      <td class="govuk-table__cell font-xxsmall">{{ version.memo_line }}</td>
      <td class="govuk-table__cell font-xxsmall">{{ version.natural_account_code }}</td>
    </tr>
    {% endif %}
    {% endfor %}
    </tbody>
  </table>
  <p class="govuk-body"><a href="#" class="govuk-back-link">Back to top</a></p>
</div>

  {% endblock %}