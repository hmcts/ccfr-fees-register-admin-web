{% from "includes/macros/form.njk" import errorSummary, textArea, textInput, radioGroup, submitButton, selectInline, selectReferenceData %}
  {% extends "layout.njk" %}

  {% set title = t('Fee details') %}
  {% block content %}
<input type='hidden' id='userRole' value='{{ 'Approver' if isApprover(user.allInfo.roles) else 'Editor' }}'/>
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <div class="govuk-panel govuk-panel--confirmation">
        <h2 class="govuk-panel__title">{{feeCode}} has been deleted</h2>
      </div>
    </div>
    <div class="govuk-grid-column-full">
      <h2 class="govuk-heading-m">What happens next</h2>
      <p class="govuk-body">You can go back to your draft fees to edit other fee details or create a new fee.</p>
    </div>
    <div class="govuk-grid-column-full">
      <a href="/admin/v2/draft-fees" class="govuk-button" role="button" draggable="false" data-module="govuk-button">
        View draft fees
      </a>     
    </div>
  </div>
  {% endblock %}
