  {% extends "layout.njk" %}

  {% set title = t('CSV upload | ' + serviceName) %}
  {% set heading = t('CSV upload') %}

  {% block content %}

<div class="govuk-grid-row">
<input type='hidden' id='userRole' value='{{ 'Approver' if isApprover(user.allInfo.roles) else 'Editor' }}'/>

  <div class="govuk-grid-column-full">
    <form method="post" action="upload?_csrf={{csrfToken}}" enctype="multipart/form-data">
      {% if UPLOAD_ERR %}
      <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
          <h2 class="govuk-error-summary__title" id="failure-error-summary-heading">
            {{ t('There is a problem') }}
          </h2>
          <div class="govuk-error-summary__body">
            <ul class="govuk-list govuk-error-summary__list">
              <li><a href="#csvdata">{{ UPLOAD_ERR_MSG }}</a></li>
            </ul>
          </div>
        </div>
      </div>
      {% endif %}

      <div id="upload-form" class="govuk-form-group {{ 'govuk-form-group--error' if UPLOAD_ERR }}">
        <label class="govuk-label govuk-label--s" for="csvdata">
          {{ t('Upload a file') }}
        </label>
        {% if UPLOAD_ERR %}
        <p id="csvdata-error" class="govuk-error-message">
          <span class="govuk-visually-hidden">{{ t('Error') }}:</span> {{ UPLOAD_ERR_MSG }}
        </p>
        {% endif %}
        <input class="govuk-file-upload {{ 'govuk-file-upload--error' if UPLOAD_ERR }}" type="file" id="csvdata" name="csvdata" accept="text/csv"{% if UPLOAD_ERR %} aria-describedby="csvdata-error"{% endif %}/>
      </div>

      <div class="govuk-button-group">
        <button id="submit" type="submit" class="govuk-button" data-module="govuk-button">{{ t('Next') }}</button>
        <a href="/admin/V2/all-fees" class="govuk-link">{{ t('Cancel') }}</a>
      </div>
    </form>
  </div>
</div>
  {% endblock %}
