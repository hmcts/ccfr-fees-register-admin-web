
  {% extends "layout.njk" %}
  {% set title = t('Fee details') %}
  {% block content %}
  <input type='hidden' id='userRole' value=''/>
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <div class="govuk-panel govuk-panel--confirmation">
        <h2 class="govuk-panel__title">{{feeCode}} has been rejected</h2>
        <div class="govuk-panel__body">
          Fee moved back to drafts for the editor to review.
        </div>
      </div>
    </div>
    <div class="govuk-grid-column-full">
      <h2 class="govuk-heading-m">What happens next</h2>
      <p class="govuk-body">The editor will need to review the draft fee before submitting it to you for approval again.</p>
    </div>
    <div class="govuk-grid-column-full">
      <a href="/admin/v2/pending-approval" class="govuk-button" role="button" draggable="false" data-module="govuk-button">
            View fees awaiting approval
      </a>     
    </div>
  </div>
  {% endblock %}