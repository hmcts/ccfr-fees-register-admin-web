{% extends "layout.njk" %}
{% set title = t('Reference data | ' + serviceName) %}
  {% set heading = t('Reference data') %}

  {% block content %}
  <input type='hidden' id='userRole' value=''/>
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <details class="govuk-details">
        <summary class="govuk-details__summary">
          <span class="govuk-details__summary-text">
            Applicants
          </span>
        </summary>
        <div class="govuk-details__text">
          <ul class="govuk-list reference-ul">
            {% for applicant in applicants %}
              <li>{{ applicant.name }}</li>
            {% endfor %}
          </ul>
        </div>
      </details>

      <details class="govuk-details">
        <summary class="govuk-details__summary">
          <span class="govuk-details__summary-text">
            Jurisdictions 1
          </span>
        </summary>
        <div class="govuk-details__text">
          <ul class="govuk-list reference-ul">
            {% for jurisdiction in jurisdictions %}
              <li>{{ jurisdiction.name }}</li>
            {% endfor %}
          </ul>
        </div>
      </details>

      <details class="govuk-details">
        <summary class="govuk-details__summary">
          <span class="govuk-details__summary-text">
            Jurisdictions 2
          </span>
        </summary>
        <div class="govuk-details__text">
          <ul class="govuk-list reference-ul">
            {% for jurisdiction in jurisdictions2 %}
              <li>{{ jurisdiction.name }}</li>
            {% endfor %}
          </ul>
        </div>
      </details>

      <details class="govuk-details">
        <summary class="govuk-details__summary">
          <span class="govuk-details__summary-text">
            Services
          </span>
        </summary>
        <div class="govuk-details__text">
          <ul class="govuk-list reference-ul">
            {% for service in services %}
              <li>{{ service.name }}</li>
            {% endfor %}
          </ul>
        </div>
      </details>

      <details class="govuk-details">
        <summary class="govuk-details__summary">
          <span class="govuk-details__summary-text">
            Channels
          </span>
        </summary>
        <div class="govuk-details__text">
          <ul class="govuk-list reference-ul">
            {% for channel in channels %}
              <li>{{ channel.name }}</li>
            {% endfor %}
          </ul>
        </div>
      </details>

      <details class="govuk-details">
        <summary class="govuk-details__summary">
          <span class="govuk-details__summary-text">
            Events
          </span>
        </summary>
        <div class="govuk-details__text">
          <ul class="govuk-list reference-ul">
            {% for event in events %}
              <li>{{ event.name }}</li>
            {% endfor %}
          </ul>
        </div>
      </details>

      <details class="govuk-details">
        <summary class="govuk-details__summary">
          <span class="govuk-details__summary-text">
            Directions
          </span>
        </summary>
        <div class="govuk-details__text">
          <ul class="govuk-list reference-ul">
            {% for direction in directions %}
              <li>{{ direction.name }}</li>
            {% endfor %}
          </ul>
        </div>
      </details>
    </div>
  </div>
  {% endblock %}
