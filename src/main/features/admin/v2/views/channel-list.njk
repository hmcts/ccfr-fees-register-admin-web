{% extends "layout.njk" %}

  {% set title = t('channels | ' + serviceName) %}
  {% set heading = t('channels') %}

  {% block content %}

<div class="govuk-grid-column-full">
  <table class="govuk-table">
    <thead class="govuk-table__head">
    <tr class="govuk-table__row">
      <th class="govuk-table__header" scope="col">Name</th>
    </tr>
    </thead>
    <tbody class="govuk-table__body">
    {% for channel in channels %}
    <tr class="govuk-table__row">
      <td class="govuk-table__cell">{{ channel.name }}</td>
    </tr>
    {% endfor %}
    </tbody>
  </table>

  <p class="govuk-body"><a href="/admin/welcome/" class="govuk-back-link">{{ t("Back to welcome page") }}</a></p>
</div>

  {% endblock %}
