{% set currentPage = 'create-edit-fee' %}

{% from "includes/macros/form.njk" import csrfProtection,
errorMessage,
textArea,
textInput,
dateInput,
radioGroup,
submitButton %}
{% extends "layout.njk" %}

{% if edit %}
  {% set thisPageHeading = 'Edit Fee' %}
{% else %}
  {% set thisPageHeading = 'Create a new fee' %}
{% endif %}

{% set title = t(thisPageHeading + ' | ' + serviceName) %}
{% set heading = t(thisPageHeading) %}

{# Radio list built from reference data. Ids are the reference data names, which the acceptance tests rely on. #}
{% macro referenceRadios(name, label, items, form, columns = false) %}
  {% set error = form.errorFor(name) %}
  {% set selection = form.valueFor(name) %}
<div class="govuk-form-group {{ 'govuk-form-group--error' if error }}">
  <fieldset id="{{ name }}" class="govuk-fieldset"{% if error %} aria-describedby="{{ name }}-error"{% endif %}>
    <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">{{ t(label) }}</legend>
    {% if error %}{{ errorMessage(name, error) }}{% endif %}
    <div class="govuk-radios {{ 'fee-radios--columns' if columns }}" data-module="govuk-radios">
      {% for item in items %}
      <div class="govuk-radios__item">
        <input class="govuk-radios__input" type="radio" id="{{ item.name }}" name="{{ name }}" value="{{ item.name }}"{% if selection == item.name %} checked{% endif %}>
        <label class="govuk-label govuk-radios__label" for="{{ item.name }}">{{ item.name }}</label>
      </div>
      {% endfor %}
    </div>
  </fieldset>
</div>
{% endmacro %}

{% macro amountInput(label, name, value, form, prefix = '', suffix = '') %}
  {% set error = form.errorFor(name) %}
<div class="govuk-form-group {{ 'govuk-form-group--error' if error }}">
  <label class="govuk-label govuk-label--s" for="{{ name }}" id="{{ name }}[label]">{{ t(label) }}</label>
  {% if error %}{{ errorMessage(name, error) }}{% endif %}
  <div class="govuk-input__wrapper">
    {% if prefix %}<div class="govuk-input__prefix" aria-hidden="true">{{ prefix }}</div>{% endif %}
    <input class="govuk-input govuk-input--width-10 {{ 'govuk-input--error' if error }}" type="text" inputmode="decimal"
           id="{{ name }}" name="{{ name }}" value="{{ value }}"{% if error %} aria-describedby="{{ name }}-error"{% endif %}>
    {% if suffix %}<div class="govuk-input__suffix" aria-hidden="true">{{ suffix }}</div>{% endif %}
  </div>
</div>
{% endmacro %}

{% block content %}
<input type='hidden' id='userRole' value='{{ 'Approver' if isApprover(user.allInfo.roles) else 'Editor' }}'/>
{% set feeType = form.valueFor('type') %}
{% set amountType = form.valueFor('amountType') %}
{% if amountType == 'flat' %}
  {% set flatAmountVal = form.valueFor('amount') %}
{% elif amountType == 'volume' %}
  {% set volumeAmountVal = form.valueFor('amount') %}
{% endif %}

<form method="post" id="createForm" action="create" novalidate>
  {{ csrfProtection(csrfToken) }}
  {% if edit %}
    <div class="govuk-form-group">
      <p class="govuk-body govuk-!-font-weight-bold govuk-!-margin-bottom-1">{{ t('Fee Code') }}</p>
      <p class="govuk-body">{{ form.valueFor('code') }}</p>
    </div>
    <input type="hidden" name="code" id="code" value="{{ form.valueFor('code') }}">
    <input type="hidden" name="reasonForReject" id="reasonForReject" value="{{ reasonReject }}">
    <input type="hidden" name="approvedBy" id="approvedBy" value="{{ approvedBy }}">
  {% endif %}

  {{ textArea(t('Reason For Fee Update'), 'reasonForUpdate', form, rows=2) }}
  {{ textArea(t('Description of fee'), 'description', form, rows=4) }}
  {{ textInput(t('Statutory Instrument'), 'statutoryInstrument', form, inputClass='govuk-!-width-one-half') }}
  {{ textArea(t('Last Amending SI'), 'lastAmendingSi', form, rows=2) }}
  {{ textInput(t('SI REF ID'), 'siRefId', form, inputClass='govuk-input--width-20') }}
  {{ textArea(t('Consolidated/Original Fee Order Name'), 'consolidatedFeeOrderName', form, rows=2) }}

  {{ referenceRadios('service', 'Service', referenceData.serviceTypes, form, columns=true) }}
  {{ referenceRadios('jurisdiction1', 'Jurisdiction 1', referenceData.jurisdictions1, form) }}
  {{ referenceRadios('jurisdiction2', 'Jurisdiction 2', referenceData.jurisdictions2, form, columns=true) }}

  {% set typeError = form.errorFor('type') %}
  <div class="govuk-form-group {{ 'govuk-form-group--error' if typeError }}">
    <fieldset id="type" class="govuk-fieldset"{% if typeError %} aria-describedby="type-error"{% endif %}>
      <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">{{ t('Fee Type') }}</legend>
      {% if typeError %}{{ errorMessage('type', typeError) }}{% endif %}
      <div class="govuk-radios" data-module="govuk-radios">
        <div class="govuk-radios__item">
          <input class="govuk-radios__input" type="radio" id="typefixed" name="type" value="fixed"{% if feeType == 'fixed' %} checked{% endif %}>
          <label class="govuk-label govuk-radios__label" for="typefixed">{{ t('Fixed') }}</label>
        </div>
        <div class="govuk-radios__item">
          <input class="govuk-radios__input" type="radio" id="typeranged" name="type" value="ranged"
                 data-aria-controls="ranged-container"{% if feeType == 'ranged' %} checked{% endif %}>
          <label class="govuk-label govuk-radios__label" for="typeranged">{{ t('Ranged') }}</label>
        </div>
        <div class="govuk-radios__conditional {{ 'govuk-radios__conditional--hidden' if feeType != 'ranged' }}" id="ranged-container">
          {{ radioGroup(form = form, name = 'rangeUnit', label = t('Ranged units'), options = [
            { label: t('Pounds (£)'), value: 'GBP' },
            { label: t('Volume'), value: 'Volume' }
          ]) }}
          {{ textInput(t('From'), 'fromRange', form, inputClass='govuk-input--width-10') }}
          {{ textInput(t('Up to (optional)'), 'toRange', form, inputClass='govuk-input--width-10') }}
        </div>
      </div>
    </fieldset>
  </div>

  {% set amountTypeError = form.errorFor('amountType') %}
  <div class="govuk-form-group {{ 'govuk-form-group--error' if amountTypeError }}">
    <fieldset id="amountType" class="govuk-fieldset"{% if amountTypeError %} aria-describedby="amountType-error"{% endif %}>
      <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">{{ t('Amount Type') }}</legend>
      {% if amountTypeError %}{{ errorMessage('amountType', amountTypeError) }}{% endif %}
      <div class="govuk-radios" data-module="govuk-radios">
        <div class="govuk-radios__item">
          <input class="govuk-radios__input" type="radio" id="amountTypeflat" name="amountType" value="flat"
                 data-aria-controls="flatAmount"{% if amountType == 'flat' %} checked{% endif %}>
          <label class="govuk-label govuk-radios__label" for="amountTypeflat">{{ t('Flat') }}</label>
        </div>
        <div class="govuk-radios__conditional {{ 'govuk-radios__conditional--hidden' if amountType != 'flat' }}" id="flatAmount">
          {{ amountInput('Amount', 'amount', flatAmountVal, form, prefix='£') }}
        </div>
        <div class="govuk-radios__item">
          <input class="govuk-radios__input" type="radio" id="amountTypepercentage" name="amountType" value="percentage"
                 data-aria-controls="percentageAmount"{% if amountType == 'percentage' %} checked{% endif %}>
          <label class="govuk-label govuk-radios__label" for="amountTypepercentage">{{ t('Percentage') }}</label>
        </div>
        <div class="govuk-radios__conditional {{ 'govuk-radios__conditional--hidden' if amountType != 'percentage' }}" id="percentageAmount">
          {{ amountInput('Percentage', 'percentage', form.valueFor('percentage'), form, suffix='%') }}
        </div>
        <div class="govuk-radios__item">
          <input class="govuk-radios__input" type="radio" id="amountTypevolume" name="amountType" value="volume"
                 data-aria-controls="volumeAmount"{% if amountType == 'volume' %} checked{% endif %}>
          <label class="govuk-label govuk-radios__label" for="amountTypevolume">{{ t('Volume') }}</label>
        </div>
        <div class="govuk-radios__conditional {{ 'govuk-radios__conditional--hidden' if amountType != 'volume' }}" id="volumeAmount">
          {{ amountInput('Amount', 'volAmount', volumeAmountVal, form, prefix='£') }}
        </div>
      </div>
    </fieldset>
  </div>

  {{ referenceRadios('event', 'Event', referenceData.eventTypes, form, columns=true) }}
  {{ referenceRadios('channel', 'Channel', referenceData.channelTypes, form) }}

  {{ textInput(t('Keyword'), 'keyword', form, inputClass='govuk-input--width-20') }}
  <p id="keyword-error" class="govuk-error-message" hidden>
    <span class="govuk-visually-hidden">{{ t('Error') }}:</span> {{ t('Keyword already in use') }}
  </p>

  {{ referenceRadios('applicantType', 'Applicant', referenceData.applicantTypes, form) }}
  {{ referenceRadios('direction', 'Direction', referenceData.directionTypes, form, columns=true) }}

  {{ textInput(t('Memo Line'), 'memoLine', form) }}
  {{ dateInput(t('From Date'), 'fromDate', form) }}
  {{ dateInput(t('To Date'), 'toDate', form) }}
  {{ textInput(t('Natural Account Code'), 'naturalAccountCode', form, inputClass='govuk-input--width-10') }}
  <input type="hidden" name="edit" id="edit" value="{{ edit }}">

  {{ submitButton(t('Save as draft')) }}
</form>
{% endblock %}
