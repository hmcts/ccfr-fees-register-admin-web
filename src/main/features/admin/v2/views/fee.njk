{% extends "layout1.njk" %}

  {% set title = t('Fee | ' + serviceName) %}
  {% set heading = t('Fee details')  %}
  {% block content %}
<div class="govuk-grid-row downloadbtn-container ">
  <div class="govuk-grid-column-one-third">
    <label class="govuk-!-font-weight-bold">Code:</label> {{ feeDto.code }}
  </div>
  <div class="govuk-grid-column-one-third">
    <label class="govuk-!-font-weight-bold">Type:</label> {{ feeDto.fee_type }}
  </div>
</div>
<hr width=100%>

  {% if feeDto.fee_type == 'ranged' %}
<div class="govuk-grid-row">
<div class="govuk-grid-column-one-third">
  <label class="govuk-!-font-weight-bold">Min range:</label> {{ feeDto.min_range }}
</div>
<div class="govuk-grid-column-one-third">
  <label class="govuk-!-font-weight-bold">Max range:</label> {{ feeDto.max_range }}
</div>
<div class="govuk-grid-column-one-third">
  <label class="govuk-!-font-weight-bold">Range unit:</label> {{ feeDto.range_unit }}
</div>
</div>
<hr width=100%>

  {% endif %}

<div class="govuk-grid-row">
<div class="govuk-grid-column-one-third">
  <label class="govuk-!-font-weight-bold">Channel:</label> {{ feeDto.channel_type.name }}
</div>
<div class="govuk-grid-column-one-third">
  <label class="govuk-!-font-weight-bold">Event:</label> {{ feeDto.event_type.name }}
</div>
<div class="govuk-grid-column-one-third">
  <label class="govuk-!-font-weight-bold">Jurisdiction1:</label> {{ feeDto.jurisdiction1.name }}
</div>
<hr>
<div class="govuk-grid-column-one-third">
  <label class="govuk-!-font-weight-bold">Jurisdiction2:</label> {{ feeDto.jurisdiction2.name }}
</div>
<div class="govuk-grid-column-one-third">
  <label class="govuk-!-font-weight-bold">Service:</label> {{ feeDto.service_type.name }}
</div>
<div class="govuk-grid-column-one-third">
  <label class="govuk-!-font-weight-bold">Keyword:</label> {{ feeDto.keyword }}
</div>
<div class="govuk-grid-column-one-third">
  <label class="govuk-!-font-weight-bold">Applicant type:</label> {{ feeDto.applicant_type.name }}
</div>
</div>
<hr width=100%>


<div class="govuk-grid-row">
<div class="column">
  <h2 class="govuk-heading-m">
    <label class="govuk-!-font-weight-bold">Live version</label>
  </h2>
</div>
</div>

<div class="govuk-grid-row">
<div class="govuk-grid-column-one-third">
  <label class="govuk-!-font-weight-bold">version:</label> {{ feeDto.current_version.version }}
</div>
<div class="govuk-grid-column-one-third">
  <label class="govuk-!-font-weight-bold">Valid from:</label> {{ feeDto.current_version.valid_from }}
</div>
<div class="govuk-grid-column-one-third">
  <label class="govuk-!-font-weight-bold">Valid to:</label> {{ feeDto.current_version.valid_to }}
</div>
<div class="govuk-grid-column-one-third">
  <label class="govuk-!-font-weight-bold">Author:</label> {{ feeDto.current_version.author }}
</div>
<div class="govuk-grid-column-one-third">
  <label class="govuk-!-font-weight-bold">Approved by:</label> {{ feeDto.current_version.approvedBy }}
</div>
<div class="govuk-grid-column-one-third">
  <label class="govuk-!-font-weight-bold">Direction:</label> {{ feeDto.current_version.direction }}
</div>
<div class="govuk-grid-column-one-third">
  <label class="govuk-!-font-weight-bold">Status:</label> {{ feeDto.current_version.status }}
</div>
<div class="govuk-grid-column-one-third">
  <label class="govuk-!-font-weight-bold">Amount:</label>
  {% if feeDto.current_version.flat_amount.amount %}
  {{ feeDto.current_version.flat_amount.amount }}
  {% elif feeDto.current_version.percentage_amount.percentage %}
  {{ feeDto.current_version.percentage_amount.percentage }}
  {% endif %}
</div>
<div class="govuk-grid-column-two-thirds">
  <label class="govuk-!-font-weight-bold">Memo line:</label> {{ feeDto.current_version.memo_line }}
</div>
<div class="govuk-grid-column-two-thirds">
  <label class="govuk-!-font-weight-bold">Natural account code:</label> {{ feeDto.current_version.natural_account_code }}
</div>
<div class="govuk-grid-column-two-thirds">
  <label class="govuk-!-font-weight-bold">Description:</label> {{ feeDto.current_version.description }}
</div>
</div>
<hr width=100%>

<div class="govuk-grid-row">
<div class="column">
  <h2 class="govuk-heading-m">
    <label class="govuk-!-font-weight-bold">Versions</label>
  </h2>
</div>
</div>


  {% for version in feeDto.fee_versions%}
<div class="govuk-grid-row">
<div class="govuk-grid-column-one-third">
  <label class="govuk-!-font-weight-bold">version:</label> {{ version.version }}
</div>
<div class="govuk-grid-column-one-third">
  <label class="govuk-!-font-weight-bold">Valid from:</label> {{ version.valid_from }}
</div>
<div class="govuk-grid-column-one-third">
  <label class="govuk-!-font-weight-bold">Valid to:</label> {{ version.valid_to }}
</div>
<div class="govuk-grid-column-one-third">
  <label class="govuk-!-font-weight-bold">Author:</label> {{ version.author }}
</div>
<div class="govuk-grid-column-one-third">
  <label class="govuk-!-font-weight-bold">Approved by:</label> {{ version.approvedBy }}
</div>
<div class="govuk-grid-column-one-third">
  <label class="govuk-!-font-weight-bold">Direction:</label> {{ version.direction }}
</div>
<div class="govuk-grid-column-one-third">
  <label class="govuk-!-font-weight-bold">Status:</label> {{ version.status }}
</div>
<div class="govuk-grid-column-one-third">
  <label class="govuk-!-font-weight-bold">Amount:</label>
  {% if version.flat_amount.amount %}
  {{ version.flat_amount.amount }}
  {% elif version.percentage_amount.percentage %}
  {{ version.percentage_amount.percentage }}
  {% endif %}
</div>
<div class="govuk-grid-column-two-thirds">
  <label class="govuk-!-font-weight-bold">Memo line:</label> {{ version.memo_line }}
</div>
<div class="govuk-grid-column-two-thirds">
  <label class="govuk-!-font-weight-bold">Natural account code:</label> {{ version.natural_account_code }}
</div>
<div class="govuk-grid-column-two-thirds">
  <label class="govuk-!-font-weight-bold">Description:</label> {{ version.description }}
</div>
</div>
<hr width=100%>
  {% endfor %}
{% if not isDraftVersionExists(feeDto) %}
  {% if isEditor(user.allInfo.roles) %}
  <div class="govuk-grid-row">
  <div class="column">
    <h2 class="govuk-heading-m">
      <label class="govuk-!-font-weight-bold">Actions</label>
    </h2>
  </div>
  </div>

  <div class="govuk-grid-row">
  <div class="govuk-grid-column-one-third">
    <ul class="govuk-list govuk-list--bullet">
      <li>
        {% if feeDto.current_version.flat_amount.amount %}
          {% set type = 'flat' %}
        {% elif feeDto.current_version.percentage_amount.percentage %}
          {% set type = 'percentage' %}
        {% elif feeDto.current_version.volume_amount.volume %}
          {% set type = 'volume' %}
        {% endif %}
        <a href="/admin/v2/fees/version/create/{{ feeDto.code }}?type={{ type }}" class="link">{{ t("Create a new fee version") }}</a>
      </li>
    </ul>
  </div>
  </div>
  <hr width=100%>
  {% endif %}
{% endif %}


<div class="govuk-grid-row">
<div class="column">
  <p><a href="/fees" class="govuk-back-link">{{ t("View all fees") }}</a></p>
</div>
</div>
  {% endblock %}
