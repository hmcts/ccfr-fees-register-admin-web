{% from "includes/macros/form.njk" import errorSummary -%}
{% block top_of_page %}{% endblock %}
<!DOCTYPE html>
<html lang="{{ html_lang|default('en') }}" class="govuk-template">
<head>
  <meta charset="utf-8"/>
  <title>{{ title }}</title>

  <link rel="icon" sizes="48x48" href="{{ asset_paths['images_vendor'] }}/favicon.ico?{{ asset_version }}">
  <link rel="icon" sizes="any" href="{{ asset_paths['images_vendor'] }}/favicon.svg?{{ asset_version }}" type="image/svg+xml">
  <link rel="mask-icon" href="{{ asset_paths['images_vendor'] }}/govuk-icon-mask.svg?{{ asset_version }}" color="#0b0c0c">
  <link rel="apple-touch-icon" href="{{ asset_paths['images_vendor'] }}/govuk-icon-180.png?{{ asset_version }}">

  {% if development %}
  <link href="{{ asset_paths['style_vendor'] }}/HTMLCSAuditor.css" rel="stylesheet"/>
  {% endif %}

  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta property="og:image"
        content="{{ asset_paths['images_vendor'] }}/govuk-opengraph-image.png?{{ asset_version }}">

  {% block head %}{% endblock %}
</head>
<body class="govuk-template__body {% block body_classes %}{% endblock %} {{ 'fees-overflow-scroll' if (currentPage == 'all-fees' or currentPage == 'all-approvedbutnotlive' or currentPage == 'all-discontinued') else '' }} ">
<script>document.body.className += ' js-enabled' + ('noModule' in HTMLScriptElement.prototype ? ' govuk-frontend-supported' : '');</script>


{% block body_start %}{% endblock %}

<a href="#content" class="govuk-skip-link" data-module="govuk-skip-link">{{ skip_link_message|default('Skip to main content') }}</a>

<div id="global-cookie-message">

  {% block cookie_message %}{% endblock %}

</div>


<header class="govuk-template__header">
  {% include "includes/header.njk" %}
</header>


{% block after_header %}{% endblock %}

<main id="content" class="govuk-width-container govuk-!-padding-bottom-6" role="main">
  {% if form %}
  {{ errorSummary(form) }}
  {% endif %}

  {% if heading %}
  <h1 class="{% if xLargeTable %}{{ xLargeTable }}{{ t('-') }}heading-xlarge{% else %}govuk-heading-xl{% endif %}">
    {{ heading }}
    {% if headingSecondary %}
    <span class="govuk-caption-l">{{ headingSecondary }}</span>
    {% endif %}
  </h1>
  {% endif %}

  {% block content %}{% endblock %}
</main>

{% block footer %}
  {% include "includes/footer.njk" %}
{% endblock %}

<div id="global-app-error" class="app-error govuk-!-display-none"></div>

{% block body_end %}{% endblock %}

</body>
</html>
