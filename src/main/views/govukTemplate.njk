{% block top_of_page %}{% endblock %}
<!DOCTYPE html>
<html lang="{{ html_lang|default('en') }}" class="govuk-template">
<head>
  <meta charset="utf-8"/>
  <title>{{ title }}</title>

  <link rel="icon" sizes="48x48" href="{{ asset_paths['images_vendor'] }}/favicon.ico?{{ asset_version }}">
  <link rel="icon" sizes="any" href="{{ asset_paths['images_vendor'] }}/favicon.svg?{{ asset_version }}" type="image/svg+xml">
  <link rel="mask-icon" href="{{ asset_paths['images_vendor'] }}/govuk-icon-mask.svg?{{ asset_version }}" color="#0b0c0c">
  <link rel="apple-touch-icon" href="{{ asset_paths['images_vendor'] }}/govuk-icon-180.png?{{ asset_version }}">

  {% if development %}
  <link href="{{ asset_paths['style_vendor'] }}/HTMLCSAuditor.css" rel="stylesheet"/>
  {% endif %}

  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta property="og:image"
        content="{{ asset_paths['images_vendor'] }}/govuk-opengraph-image.png?{{ asset_version }}">

  {% block head %}{% endblock %}
</head>
<body class="govuk-template__body {% block body_classes %}{% endblock %} {{ 'fees-overflow-scroll' if (currentPage == 'all-fees' or currentPage == 'all-approvedbutnotlive' or currentPage == 'all-discontinued') else '' }} ">
<script>document.body.className += ' js-enabled' + ('noModule' in HTMLScriptElement.prototype ? ' govuk-frontend-supported' : '');</script>


{% block body_start %}{% endblock %}

<a tabindex="1" href="#content" class="govuk-skip-link" data-module="govuk-skip-link">{{ skip_link_message|default('Skip to main content') }}</a>

{% block cookie_banner %}{% endblock %}

<header role="banner" id="global-header" class="{% block header_class %}{% endblock %}">
  <div class="header">
    <div class="header-global">
      <div class="header-proposition">
        <a tabindex="1" href="{{ homepage_url|default('https://www.gov.uk') }}" class="custom-header-title">{{ t('Fee register') }} </a>
        {% if isLoggedIn %}
          <ul class="custom-logout">

          <p class="username-log">{{ user.allInfo.forename }} {{ user.allInfo.surname }}</p>
          <a tabindex="1" href="/logout" class="custom-signout-link">{{ t('Sign out') }}</a>
          </ul>

          {% endif %}
      <ul class="custom-header-ul">
        <a tabindex="2" href="/admin/V2/all-fees" class="custom-draft-all-fees">{{ t('Fees') }} </a>
        {% if isEditor(user.allInfo.roles) or isAdmin(user.allInfo.roles) %}
        <a tabindex="2" href="/admin/V2/draft-fees" class="custom-draft-all-fees">{{ t('Your Drafts') }} </a>
        <a tabindex="2" href="/admin/v2/upload" class="custom-draft-all-fees">{{ t('Upload fees') }} </a>
        {% elif isApprover(user.allInfo.roles)%}
        <a tabindex="2" href="/admin/V2/pending-approval" class="custom-draft-all-fees">{{ t('Approvals') }} </a>
        {% endif %}
        <a tabindex="2" href="/admin/V2/reference-data" id="referenceData" class="custom-draft-all-fees">{{ t('Reference Data') }} </a>
      </ul>
      </div>
      {% block inside_header %}{% endblock %}
    </div>
    {% block proposition_header %}{% endblock %}
  </div>
</header>


{% block after_header %}{% endblock %}

<main id="content" class="govuk-width-container govuk-!-padding-bottom-6" role="main">
  {% if form %}
  {{ errorSummary(form) }}
  {% endif %}

  {% if heading %}
  <h1 class="{% if xLargeTable %}{{ xLargeTable }}{{ t('-') }}heading-xlarge{% else %}govuk-heading-xl{% endif %}">
    {{ heading }}
    {% if headingSecondary %}
    <span class="govuk-caption-l">{{ headingSecondary }}</span>
    {% endif %}
  </h1>
  {% endif %}

  {% block content %}{% endblock %}
</main>

{% block footer %}
  {% include "includes/footer.njk" %}
{% endblock %}

<div id="global-app-error" class="app-error govuk-!-display-none"></div>

{% block body_end %}{% endblock %}

</body>
</html>
