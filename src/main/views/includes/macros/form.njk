{% macro errorMessage(id, error) %}
<p id="{{ id }}-error" class="govuk-error-message">
  <span class="govuk-visually-hidden">{{ t('Error') }}:</span> {{ t(error) }}
</p>
{% endmacro %}

{% macro describedBy(id, hint, error) -%}
{%- set ids = (id + '-hint ' if hint else '') + (id + '-error' if error else '') -%}
{%- if ids | trim %} aria-describedby="{{ ids | trim }}"{% endif -%}
{%- endmacro %}

{% macro input(label, name, form, hint='', type='text', inputClass='', disabled = false) %}
  {% set error = form.errorFor(name) %}
<div class="govuk-form-group {% if error %} govuk-form-group--error {% endif %}">
  <label for="{{ name }}" id="{{ name }}[label]" class="govuk-label govuk-label--s">{{ label }}</label>
  {% if hint != '' %}<div id="{{ name }}-hint" class="govuk-hint">{{ hint }}</div>{% endif %}
  {% if error %}{{ errorMessage(name, error) }}{% endif %}
  <input id="{{ name }}" name="{{ name }}" type="{{ type }}"
         class="govuk-input {{ inputClass }} {% if error %} govuk-input--error {% endif %}"
         value="{{ form.valueFor(name) }}"{{ describedBy(name, hint, error) }} {% if disabled %} disabled="disabled" {% endif %}>
</div>
  {% endmacro %}

  {% macro textInput(label, name, form, hint='', inputClass='', disabled = false) %}
  {{ input(label, name, form, hint, 'text', inputClass, disabled) }}
  {% endmacro %}

  {% macro dateInput(label, name, form, hint='') %}
  {{ input(label, name, form, hint, 'date', 'govuk-input--width-10') }}
  {% endmacro %}

  {% macro textInputInline( name, form, inputClass='', prefixClass='') %}
  {% set error = form.errorFor(name) %}
<label for="{{ name }}"></label>
<span class="{{ prefixClass }}">
    <input id="{{ name }}" name="{{ name }}" type="text"
           class="govuk-input {{ inputClass }} {% if error %} govuk-input--error {% endif %}"
           value="{{ form.valueFor(name) }}">
  </span>
  {% endmacro %}

  {% macro emailInput(label, name, form, hint='') %}
  {{ input(label, name, form, hint, 'email') }}
  {% endmacro %}

  {% macro textArea(label, name, form, rows=5) %}
  {% set error = form.errorFor(name) %}
<div class="govuk-form-group {% if error %} govuk-form-group--error {% endif %}">
<label for="{{ name }}" id="{{ name }}[label]" class="govuk-label govuk-label--s">{{ label }}</label>
{% if error %}{{ errorMessage(name, error) }}{% endif %}
<textarea id="{{ name }}" name="{{ name }}" rows="{{ rows }}"
          class="govuk-textarea govuk-!-width-three-quarters {% if error %} govuk-textarea--error {% endif %}"{{ describedBy(name, '', error) }}>{{ form.valueFor(name) }}</textarea>
</div>
  {% endmacro %}

  {% macro submitButton(label) %}
<div class="govuk-form-group">
<button id="submit" type="submit" class="govuk-button" data-module="govuk-button">{{ t(label) | default(t('Continue')) }}</button>
</div>
  {% endmacro %}

    {% macro nextButton(label, className) %}
<div class="govuk-form-group">
<button id="submit" type="submit" class="{{ t(className) | default(t('govuk-button')) }}" data-module="govuk-button">{{ t(label) | default(t('Continue')) }}</button>
</div>
  {% endmacro %}

  {% macro yesNoRadio(label, name, form) %}
  {{ radioGroup(
  label,
  name,
  [
  { label: 'Yes', value: true },
  { label: 'No', value: false }
  ],
  form,
  isInline = true
  ) }}
  {% endmacro %}

  {% macro radioOption(label, name, form, value, hint = '', checked = form.valueFor(name) == value, bold = false, disabled = false) %}
  {{ option(label, name, form, value, 'radio', hint, checked, bold, disabled) }}
  {% endmacro %}

  {% macro checkboxOption(label, name, form, value, hint = '', checked = false, bold = false) %}
  {{ option(label, name, form, value, 'checkbox', hint, checked, bold) }}
  {% endmacro %}

  {% macro option(label, name, form, value, type, hint = '', checked = false, bold = false, disabled = false) %}
{% set kind = 'radios' if type == 'radio' else 'checkboxes' %}
{% set idValue = name + value | replace(' ', '') %}
<div class="govuk-{{ kind }}__item">
<input class="govuk-{{ kind }}__input" id="{{ idValue }}" type="{{ type }}" name="{{ name }}"
       value="{{ value }}" {% if checked %} checked="checked" {% endif %} {% if disabled %} disabled="disabled" {% endif
%}{% if hint %} aria-describedby="{{ idValue }}-hint"{% endif %}>
<label class="govuk-label govuk-{{ kind }}__label {% if bold and hint %}govuk-label--s{% endif %}" for="{{ idValue }}">
  {{ t(label) }}
</label>
{% if hint %}
<div id="{{ idValue }}-hint" class="govuk-hint govuk-{{ kind }}__hint">{{ t(hint) }}</div>
{% endif %}
</div>
  {% endmacro %}

  {% macro checkboxGroup(label, name, options, form, isInline = false, bold = false, legendHidden = false) %}
  {% set error = form.errorFor(name) %}
  {% set selection = form.valueFor(name) %}
<div class="govuk-form-group {% if error %} govuk-form-group--error {% endif %}">
<fieldset class="govuk-fieldset" id="{{ name }}[label]"{{ describedBy(name, '', error) }}>
<legend class="govuk-fieldset__legend govuk-fieldset__legend--s {% if legendHidden %}govuk-visually-hidden{% endif %}">
  {{ label }}
</legend>
{% if error %}{{ errorMessage(name, error) }}{% endif %}
<div class="govuk-checkboxes {% if isInline %}govuk-checkboxes--inline{% endif %}" data-module="govuk-checkboxes">
{% for option in options %}
{{ checkboxOption(
label = option.label,
name = name,
form = form,
value = option.value,
hint = option.hint,
checked = (selection === option.value),
bold = bold
) }}
{% endfor %}
</div>
</fieldset>
  </div>
  {% endmacro %}

  {% macro radioGroup(label, name, options, form, isInline = false, disabled = false) %}
  {% set error = form.errorFor(name) %}
  {% set selection = form.valueFor(name) %}
<div class="govuk-form-group {% if error %} govuk-form-group--error {% endif %}">
<fieldset class="govuk-fieldset" id="{{ name }}[label]"{{ describedBy(name, '', error) }}>
<legend class="govuk-fieldset__legend govuk-fieldset__legend--s">
  {{ label }}
</legend>
{% if error %}{{ errorMessage(name, error) }}{% endif %}
<div class="govuk-radios {% if isInline %}govuk-radios--inline{% endif %}" data-module="govuk-radios">
{% for option in options %}
{{ radioOption(
label = option.label,
name = name,
form = form,
value = option.value,
hint = option.hint,
checked = (selection === option.value),
bold = option.bold,
disabled = disabled
) }}
{% endfor %}
</div>
</fieldset>
  </div>
  {% endmacro %}

  {% macro selectReferenceData(name, options, form, displayName, disabled = false) %}
  {% set error = form.errorFor(name) %}
  {% set selection = form.valueFor(name) %}

<div class="govuk-form-group {% if error %} govuk-form-group--error {% endif %}">

<label for="{{ name }}" class="govuk-label govuk-label--s" id="{{ name }}[label]">
  {{ displayName }}
</label>
{% if error %}{{ errorMessage(name, error) }}{% endif %}
<select class="govuk-select {% if error %} govuk-select--error {% endif %}"
        id="{{ name }}" name="{{ name }}"{{ describedBy(name, '', error) }} {% if disabled %} disabled="disabled" {% endif %} >
<option disabled="disabled"
{% if selection === '' %}selected{% endif %} value="">
</option>
  {% for option in options %}
<option value="{{ option.name }}" {% if selection === option.name %}selected{% endif %} >
  {{ option.name }}
  </option>
  {% endfor %}
  </select>
  </div>

  {% endmacro %}

  {% macro selectInline(name, options, form) %}
  {% set error = form.errorFor(name) %}
  {% set selection = form.valueFor(name) %}
<label for="{{ name }}"></label>
<select class="govuk-select" id="{{ name }}" name="{{ name }}">
{% for option in options %}
<option value="{{ option.value }}"
{% if option.value == selection %} selected {% endif %}>{{ option.label }}</option>
  {% endfor %}
  </select>
  {% endmacro %}

  {% macro errorSummary(form) %}
  {% if form.hasErrors() %}
<div class="govuk-error-summary" data-module="govuk-error-summary">
<div role="alert">
<h2 class="govuk-error-summary__title" id="error-summary-heading">
  {{ t('There is a problem') }}
</h2>
<div class="govuk-error-summary__body">
<ul class="govuk-list govuk-error-summary__list">
  {% for error in form.validationErrors %}
  <li><a href="#{{ error.fieldName }}">{{ t(error.message) }}</a></li>
  {% endfor %}
  {% for error in form.backendErrors %}
  <li>{{ t(error) }}</li>
  {% endfor %}
</ul>
</div>
</div>
</div>
  {% endif %}
  {% endmacro %}

  {% macro csrfProtection(token) %}
<input type="hidden" name="_csrf" value="{{ token }}">
{% endmacro %}
