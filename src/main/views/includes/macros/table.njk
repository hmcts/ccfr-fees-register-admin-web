{% macro tableStart( id, heading ) %}
<fieldset id="{{ id }}" class="govuk-form-group">
  <p class="govuk-heading-m bottom-border">{{ t( heading ) }}</p>
  <legend>
    <span class="govuk-visually-hidden">{{ t( heading ) }}</span>
  </legend>
  {% endmacro %}

  {% macro tableEnd() %}
</fieldset>
  {% endmacro %}

  {% macro row( label, value, changeLink = '' ) %}
<div class="bottom-border">
<div class="govuk-grid-column-one-third">
  <span>{{ t( label ) }}</span>
</div>
<div class="govuk-grid-column-one-third">
  <span>{{ value }}</span>
</div>
{% if changeLink !== '' %}
<div class="govuk-grid-column-one-third change-link-column">
  <a href="{{ changeLink | safe }}" class="govuk-!-font-weight-bold">{{ t('Change') }}</a>
</div>
{% endif %}
</div>
  {% endmacro %}

  {% macro rowWithMultipleValue( label, values, changeLink = '' ) %}
<div class="bottom-border">
<div class="govuk-grid-column-one-third">
  <span class="">{{ t( label ) }}</span>
</div>
<div class="govuk-grid-column-one-third">
  {% for value in values %}
  <span class="govuk-!-display-block">{{ value }}</span>
  {% endfor %}
</div>
{% if changeLink !== '' %}
<div class="govuk-grid-column-one-third change-link-column">
  <a href="{{ changeLink | safe }}" class="govuk-!-font-weight-bold">{{ t('Change') }}</a>
</div>
{% endif %}
</div>
  {% endmacro %}


