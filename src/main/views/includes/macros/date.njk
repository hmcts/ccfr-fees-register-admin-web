{% macro dateInput(name, form, hint='For example, 31 3 1980') %}
  {% set dayError = form.errorFor(name + "[day]") %}
  {% set monthError = form.errorFor(name + "[month]") %}
  {% set yearError = form.errorFor(name + "[year]") %}
  {% set dateError = form.errorFor(name) %}
  {% set error = form.hasErrors()  %}
<div class="govuk-form-group {% if error %} govuk-form-group--error {% endif %}">
  {% if hint != '' %}<div class="govuk-hint" id="dob-hint">{{ t(hint) }}</div>{% endif %}
  {% if dayError != '' %}<span class="govuk-error-message">{{ t(dayError) }}</span>{% endif %}
  {% if monthError != '' %}<span class="govuk-error-message">{{ t(monthError) }}</span>{% endif %}
  {% if yearError != '' %}<span class="govuk-error-message">{{ t(yearError) }}</span>{% endif %}
  {% if dateError != '' %}<span class="govuk-error-message">{{ t(dateError) }}</span>{% endif %}
  <div class="govuk-date-input" id="{{ name }}[label]">
    <div class="govuk-date-input__item">
      <label class="govuk-label govuk-date-input__label" id="{{ name }}[day][label]" for="dob-day">{{ t('Day') }}</label>
      <input class="govuk-input govuk-date-input__input govuk-input--width-2 {% if dayError or dateError %} govuk-input--error {% endif %}" id="{{ name }}[day]"
             name="{{ name }}[day]" value="{{ form.valueFor(name).day }}" type="number" aria-describedby="dob-hint">
    </div>
    <div class="govuk-date-input__item">
      <label class="govuk-label govuk-date-input__label" id="{{ name }}[month][label]" for="dob-month">{{ t('Month') }}</label>
      <input class="govuk-input govuk-date-input__input govuk-input--width-2 {% if monthError or dateError %} govuk-input--error {% endif %}" id="{{ name }}[month]"
             name="{{ name }}[month]" value="{{ form.valueFor(name).month }}" type="number">
    </div>
    <div class="govuk-date-input__item">
      <label class="govuk-label govuk-date-input__label" id="{{ name }}[year][label]" for="dob-year">{{ t('Year') }}</label>
      <input class="govuk-input govuk-date-input__input govuk-input--width-4 {% if yearError or dateError %} govuk-input--error {% endif %}" id="{{ name }}[year]"
             name="{{ name }}[year]" value="{{ form.valueFor(name).year }}" type="number">
    </div>
  </div>
</div>
  {% endmacro %}
