{% from "govuk/components/footer/macro.njk" import govukFooter %}

{% set newTabAttributes = { target: '_blank', rel: 'noreferrer noopener' } %}

<footer class="govuk-template__footer">
  {{ govukFooter({
    meta: {
      visuallyHiddenTitle: 'Support links',
      items: [
        { href: '/admin/cookies', text: 'Cookies' },
        { href: '/admin/accessibility', text: 'Accessibility Statement' },
        {
          href: 'https://hmcts-access.service.gov.uk/privacy-policy',
          text: 'Privacy Policy (opens in new tab)',
          attributes: newTabAttributes
        },
        {
          href: 'https://hmcts-access.service.gov.uk/terms-and-conditions',
          text: 'Terms and Conditions (opens in new tab)',
          attributes: newTabAttributes
        },
        {
          href: 'https://hmcts-access.service.gov.uk/contact-us',
          text: 'Contact Us (opens in new tab)',
          attributes: newTabAttributes
        }
      ]
    }
  }) }}
</footer>
